# Copy to .env.local (never commit real values). All variables are optional.

# Production URL, used for canonical links, sitemap.xml, robots.txt and
# absolute Open Graph image URLs. Not needed on Vercel, which provides
# VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://example.com

# Only for sub-path hosting, e.g. a GitHub Pages project site served at
# https://<user>.github.io/<repo>/  →  NEXT_PUBLIC_BASE_PATH=/<repo>
# NEXT_PUBLIC_BASE_PATH=
